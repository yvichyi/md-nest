+.library-welcome {
+  border: 0 !important; border-radius: 0 !important;
+  background: transparent !important; padding-left: 0 !important; padding-right: 0 !important;
+}
+.library-welcome h3 { font-family: var(--sleeve-display) !important; font-weight: 500 !important; line-height: 1.37 !important; }
+.welcome-orbit { opacity: .45 !important; }
+.quick-search button, .welcome-actions button, #queueLocate { border-radius: 6px !important; }
+.result { border-radius: 9px !important; }
+.result-art { border-radius: 4px !important; }
+.result-copy strong { font-weight: 550 !important; letter-spacing: -.01em !important; }
+.result-copy span { color: var(--sleeve-secondary) !important; }
+.result.current { background: color-mix(in srgb, var(--cv-accent) 8%, transparent) !important; }
+.panel-footer { color: var(--sleeve-secondary) !important; }
+.panel-footer > span { color: var(--sleeve-secondary) !important; opacity: .7; }
+@media (orientation: landscape) and (max-height: 540px) {
+  .sleeve-imprint { top: 20px; }
+  .sleeve-imprint small { display: none; }
+  .sleeve-imprint > span { font-size: 8px; letter-spacing: .15em; }
+  .topbar, .focus-toggle { top: 12px !important; }
+  .tools-toggle { width: 44px !important; height: 44px !important; }
+  .focus-toggle { min-height: 44px; font-size: 10px !important; right: calc(var(--room-gutter) + 46px) !important; }
+  .story-column { padding-top: 53px !important; }
+  .track-intro::before { display: none !important; }
+  .track-intro h1 { font-size: clamp(22px, 3.1vw, 29px) !important; margin-bottom: 5px !important; }
+  .track-intro p { font-size: 10px !important; }
+  .lyric-shell { margin-top: 14px !important; }
+  .lyric-line { font-size: clamp(13px, 1.85vw, 17px) !important; line-height: 1.38 !important; }
+  .lyric-line.active { font-size: clamp(15px, 2.05vw, 19px) !important; }
+  .disc-hint { max-width: 96%; font-size: 9px !important; letter-spacing: 0 !important; flex-direction: column; gap: 3px !important; line-height: 1.35 !important; text-align: center; }
+  .disc-hint::before { display: none; }
+  .stage.lyrics-focus .story-column { padding-top: 58px !important; }
+  .stage.lyrics-focus .folio-credit { top: 75px !important; }
+}
+@media (orientation: portrait) {
+  .sleeve-imprint { left: var(--room-gutter); top: 29px; }
+  .sleeve-imprint > span { font-size: 9px; letter-spacing: .13em; }
+  .sleeve-imprint small { display: none; }
+  .topbar { top: 17px !important; }
+  .focus-toggle { top: 17px !important; right: calc(var(--room-gutter) + 48px) !important; min-height: 44px; padding: 0 6px !important; font-size: 10px !important; }
+  .focus-direction { display: none !important; }
+  .deck-frame { max-width: calc(100vw - 64px) !important; }
+  .story-column { padding-top: 13px !important; }
+  .track-intro::before { font-size: 8px !important; margin-bottom: 10px !important; }
+  .track-intro h1 { font-size: clamp(28px, 8vw, 35px) !important; line-height: 1.13 !important; margin-bottom: 8px !important; }
+  .track-intro p { font-size: 12px !important; }
+  .lyric-shell { margin-top: 19px !important; }
+  .lyric-line { font-size: 17px !important; line-height: 1.55 !important; }
+  .lyric-line.active { font-size: 19px !important; }
+  .stage.lyrics-focus .story-column { padding-top: 110px !important; }
+  .stage.lyrics-focus .track-intro { width: 100%; box-sizing: border-box; padding-right: 90px !important; }
+  .stage.lyrics-focus .track-intro h1 { max-width: 100% !important; font-size: 28px !important; line-height: 1.17 !important; }
+  .stage.lyrics-focus .folio-credit { top: 114px !important; }
+  .library-panel { border-radius: 16px 16px 0 0 !important; }
+}
+@media (orientation: portrait) and (max-height: 720px) {
+  .track-intro h1 { font-size: 26px !important; }
+  .lyric-shell { margin-top: 10px !important; }
+  .lyric-line { font-size: 15px !important; }
+  .lyric-line.active { font-size: 17px !important; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .sleeve-imprint, .tools-toggle, .focus-toggle { transition: none !important; }
+}
