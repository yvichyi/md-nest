+}
+body {
+  background:
+    radial-gradient(ellipse 48% 65% at 81% 39%,
+      color-mix(in srgb, var(--cv-disc) 16%, transparent), transparent 76%),
+    linear-gradient(112deg, var(--cv-paper-light), var(--cv-paper) 66%,
+      color-mix(in srgb, var(--cv-paper) 86%, var(--cv-disc))) !important;
