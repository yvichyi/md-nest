+.ambient-cover { opacity: .075 !important; }
+.grain { opacity: .027 !important; }
+.sleeve-imprint {
+  position: absolute; z-index: 11;
+  top: clamp(24px, 4.6vh, 38px); left: var(--room-gutter);
